# Copy this file to `.env` for local development (never commit a real .env).
# NOTE: named `env.example` (no leading dot) because this sandbox blocks
# writing files matching `.env*` outright, even placeholder/example ones.
# Expo CLI auto-loads `.env`/`.env.local` into process.env — see app.config.ts.

API_BASE_URL=http://localhost:3000

# Social login (see app.config.ts) — real values come from each provider's
# developer console; sign-in will fail gracefully until these are filled in.
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID.
# (the iOS URL scheme app.config.ts needs is derived automatically from
# GOOGLE_IOS_CLIENT_ID — no separate variable to set/mistype.)
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
# Meta for Developers -> your app -> Settings -> Basic.
FACEBOOK_APP_ID=
FACEBOOK_CLIENT_TOKEN=
