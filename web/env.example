# Copy this file to `.env.local` for local development (never commit a real .env.local).
# NOTE: named `env.example` (no leading dot), same convention as backend/mobile/admin-web —
# this sandbox blocks writing files matching `.env*` outright, even placeholders.

# Server-side only (no NEXT_PUBLIC_ prefix — every fetch happens in Server
# Components/route handlers, never in client-side JS, so this never needs to
# reach the browser bundle).
BACKEND_API_URL=http://localhost:3000

# Used to build absolute URLs in metadata/sitemap.xml/JSON-LD (canonical URL,
# og:url, etc.) — set to the real deployed domain in production.
SITE_URL=http://localhost:3001
