# Copy this file to `.env` for local development (never commit a real .env).
# NOTE: named `env.example` (no leading dot) because this sandbox blocks
# writing files matching `.env*` outright, even placeholder/example ones.

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# Database (matches docker-compose.yml postgres service)
DATABASE_URL=postgresql://foodmap:foodmap@localhost:5432/foodmap?schema=public

# Redis (matches docker-compose.yml redis service)
REDIS_URL=redis://localhost:6379

# Auth (build-prompts/02-auth.md) - placeholders, generate a real secret before use.
# Refresh tokens are opaque random strings (hashed at rest), not JWTs, so there
# is no separate "refresh secret" to configure — only the TTL matters.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=

# Object storage (build-prompts/07-contribution-media-moderation-ai.md) —
# matches docker-compose.yml's local MinIO service. force-path-style is
# required for MinIO (and any non-AWS S3-compatible endpoint); the public
# base URL is what PhotoDto.url/thumbnailUrl are built from client-side.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=foodmap
S3_SECRET_ACCESS_KEY=foodmap12345
S3_BUCKET=foodmap-media
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/foodmap-media

# AI Summary (build-prompts/07-contribution-media-moderation-ai.md, US-J1/J2).
# minReviewCount mirrors the composite-score Bayesian prior's m=5 for consistency.
# generatedAt vs. now() >= this many days is what actually triggers a regenerate
# (see AiSummaryService.regenerateIfNeeded).
AI_SUMMARY_MIN_REVIEW_COUNT=5
AI_SUMMARY_REFRESH_INTERVAL_DAYS=7

# AI Gateway — real Claude adapter (ClaudeGatewayService). Moderation runs
# synchronously on every review/contribution submission, so it uses the
# fastest/cheapest model with a short timeout; AI Summary runs rarely in the
# background (triggered from CompositeScoreService.recompute()), so it uses
# a stronger model with no special timeout.
ANTHROPIC_API_KEY=
AI_MODERATION_MODEL=claude-haiku-4-5
AI_MODERATION_TIMEOUT_MS=8000
AI_SUMMARY_MODEL=claude-opus-5
