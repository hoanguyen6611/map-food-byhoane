# Copy to `backend/.env` on the VM — loaded into the `backend` container's
# runtime environment via `env_file:` in docker-compose.prod.yml. This is a
# DIFFERENT file from the repo-root `.env` (see .env.production.example at
# the repo root) — that one is read by Docker Compose itself to substitute
# ${POSTGRES_PASSWORD}/${MINIO_ROOT_USER}/${MINIO_ROOT_PASSWORD} inside the
# compose files; this one is read by NestJS's ConfigService inside the
# running container. DATABASE_URL, REDIS_URL, S3_ACCESS_KEY_ID, and
# S3_SECRET_ACCESS_KEY below are all overridden by docker-compose.prod.yml
# regardless of what's set here (kept in sync with the root .env
# automatically) — they're listed for documentation, not because they take
# effect from this file.
#
# Replace <VM_PUBLIC_IP> everywhere below with your actual VM's public IP
# (shown in the Oracle Cloud console after creating the instance).
#
# CAVEAT: with no domain yet, this deployment is plain HTTP — bearer tokens
# and presigned upload URLs travel unencrypted. Acceptable for a portfolio
# demo with test data; add a domain + Caddy/Let's Encrypt (a follow-up, see
# docs/deploy-oracle-cloud.md's last section) before putting real user data
# on this VM.

# Server
PORT=3000
NODE_ENV=production
# Add admin-web's/web's real origins here once those are deployed too —
# mobile's native HTTP client is unaffected by CORS (a browser-only
# mechanism), so it needs no entry here regardless.
CORS_ORIGINS=

# Overridden by docker-compose.prod.yml — shown for reference only.
DATABASE_URL=postgresql://foodmap:change-me@postgres:5432/foodmap?schema=public
REDIS_URL=redis://redis:6379

# Auth — generate real values, do not reuse the dev placeholder.
# `openssl rand -hex 32` for the secret.
JWT_ACCESS_SECRET=change-me-generate-a-real-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Object storage. S3_ENDPOINT is for the backend's OWN internal S3 calls
# (headObject/getObjectBuffer/putObject/deleteObject) — the Docker-internal
# hostname works fine here since only this container ever uses it.
# S3_PUBLIC_ENDPOINT is embedded into presigned upload URLs, which mobile
# clients hit directly over the public internet — it MUST be the VM's
# public IP, never the internal hostname (see s3.service.ts's
# presignClient). S3_PUBLIC_BASE_URL (final display/thumbnail URLs
# returned to clients) must be public for the same reason.
# S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY below are overridden by
# docker-compose.prod.yml (pinned to the root .env's MINIO_ROOT_USER/
# MINIO_ROOT_PASSWORD) — shown for reference only.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://<VM_PUBLIC_IP>:9000
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET=foodmap-media
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://<VM_PUBLIC_IP>:9000/foodmap-media

# AI Summary — unchanged from dev defaults.
AI_SUMMARY_MIN_REVIEW_COUNT=5
AI_SUMMARY_REFRESH_INTERVAL_DAYS=7

# AI Gateway — leave ANTHROPIC_API_KEY blank to keep moderation on the free
# rule-based fallback (see ClaudeGatewayService) at zero ongoing cost; fill
# it in later to switch to real Claude with no other change needed.
ANTHROPIC_API_KEY=
AI_MODERATION_MODEL=claude-haiku-4-5
AI_MODERATION_TIMEOUT_MS=8000
AI_SUMMARY_MODEL=claude-opus-5
