// Prisma schema for "The Food Map of Vietnam" backend.
// Module 1 scope only: Identity & Access + Restaurant Core entities
// per docs/06-database-erd.md §2-3. Review/Media/Moderation/Contribution
// tables are added by their own build-prompt modules (06, 07).
//
// Note on geospatial data: Prisma has no first-class PostGIS geography type,
// so `Location.geoPoint` is declared `Unsupported(...)` and is kept in sync
// with `lat`/`lng` via a DB trigger (see migration.sql) rather than through
// the Prisma Client. Geospatial queries (ST_DWithin/ST_MakeEnvelope) are run
// via `$queryRaw` in the RestaurantModule (see build-prompts/03-map-geospatial.md).
//
// CAVEAT for whoever runs the next `prisma migrate dev --create-only` (which,
// as of build-prompts/05, fails non-interactively anyway — use
// `prisma migrate diff --from-url <url> --to-schema-datamodel ./prisma/schema.prisma --script`,
// hand-create the migration folder, strip the spurious lines below, then
// `prisma migrate deploy`): the GIST index on locations.geo_point, the GIN
// trigram index on restaurants.name, the GIN index + generated column on
// restaurants.search_vector, and (as of build-prompts/06-reviews-scoring.md)
// the partial unique index `reviews_user_id_restaurant_id_active_key` (on
// `(user_id, restaurant_id) WHERE deleted_at IS NULL` — enforces "one active
// review per user per restaurant") are all hand-written raw SQL (Prisma has
// no schema-level syntax for a partial index either) and therefore invisible
// to Prisma's diff engine. Every future migration will spuriously propose
// dropping them — delete those lines from the generated migration.sql before
// applying it. Do not actually drop them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity & Access (docs/06-database-erd.md §2) ----------

enum OAuthProvider {
  google
  apple
  facebook
  none
}

enum UserStatus {
  active
  suspended
  deleted
}

enum RoleCode {
  guest
  user
  moderator
  admin
  owner
}

model Role {
  id              String           @id @default(uuid())
  code            RoleCode         @unique
  label           String
  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  description     String?
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  passwordHash    String?       @map("password_hash")
  oauthProvider   OAuthProvider @default(none) @map("oauth_provider")
  oauthSubjectId  String?       @map("oauth_subject_id")
  phone           String?
  roleId          String        @map("role_id")
  role            Role          @relation(fields: [roleId], references: [id])
  status          UserStatus    @default(active)
  emailVerifiedAt DateTime?     @map("email_verified_at")
  lastLoginAt     DateTime?     @map("last_login_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  profile                 UserProfile?
  submittedRestaurants    Restaurant[]         @relation("SubmittedRestaurants")
  ownedRestaurants        Restaurant[]         @relation("OwnedRestaurants")
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  searchHistory           SearchHistory[]
  uploadedPhotos          Photo[]
  auditLogs               AuditLog[]
  reviews                 Review[]
  moderationDecisions     ModerationResult[]   @relation("ModerationDecidedBy")
  favorites               Favorite[]
  notifications           Notification[]
  pushTokens              PushToken[]
  contributions           Contribution[]
  reviewHelpfulVotes      ReviewHelpfulVote[]
  reviewReplies           ReviewReply[]
  reportsFiled            Report[]             @relation("ReportedBy")
  reportsResolved         Report[]             @relation("ReportResolvedBy")
  crowdedStatusReports    CrowdedStatus[]      @relation("CrowdedStatusReportedBy")
  seatAvailabilityReports SeatAvailability[]   @relation("SeatAvailabilityReportedBy")
  powerOutletReports      PowerOutletStatus[]  @relation("PowerOutletReportedBy")
  parkingInfoUpdates      ParkingInformation[] @relation("ParkingLastUpdatedBy")

  // Unique index below allows multiple (none, NULL) rows since Postgres
  // treats NULL as distinct per standard unique-index semantics — this is
  // the intended behavior (only OAuth accounts need a non-null subject id).
  @@unique([oauthProvider, oauthSubjectId])
  @@map("users")
}

// Implementation detail supporting docs/build-prompts/02-auth.md's refresh-token
// rotation requirement — not itself enumerated in docs/06-database-erd.md, which
// documents domain entities rather than auth-internals plumbing. Tokens are
// stored as a SHA-256 hash (fast equality lookup), never the raw value —
// unlike password hashing, refresh tokens are high-entropy random strings, so
// a fast deterministic hash (not bcrypt) is the correct/standard choice here.
model RefreshToken {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// Single-use password reset token (30-minute expiry per docs/01-prd-mvp.md §10.1).
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model UserProfile {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName   String   @map("display_name")
  // FK to Photo added once MediaModule exists (build-prompts/07) — plain
  // nullable id for now so this table doesn't need a migration later.
  avatarPhotoId String?  @map("avatar_photo_id")
  bio           String?
  homeCity      String?  @map("home_city")
  // @handle, distinct from the DB row id — chosen/settable once by the user.
  username         String?  @unique
  // Controls whether this user's real displayName/avatar appear on THEIR
  // reviews as seen by other people (ReviewService anonymizes to "Người dùng
  // ẩn danh" otherwise) — not a general profile-visibility/blocking feature,
  // there is still no "view someone else's profile" route.
  isPublic         Boolean  @default(true) @map("is_public")
  facebookUrl      String?  @map("facebook_url")
  instagramUrl     String?  @map("instagram_url")
  favoriteCuisines String[] @default([]) @map("favorite_cuisines")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}

// ---------- Restaurant Core (docs/06-database-erd.md §3) ----------

enum RestaurantPublicationStatus {
  pending
  in_review
  published
  rejected
  hidden
  removed
}

// Was a fixed Postgres enum (FacilityType) — converted to a real lookup
// table (same shape as RestaurantCategory/Cuisine below) so admin-web can
// manage the facility list at runtime instead of every addition/rename
// needing a schema migration. `code` (not `id`) is what RestaurantFacility
// references, keeping the existing enum values ('wifi', 'parking_car', …)
// as-is — see migration 20260919000000_facility_type_to_table.
model Facility {
  id                   String               @id @default(uuid())
  code                 String               @unique
  label                String
  icon                 String?
  restaurantFacilities RestaurantFacility[]

  @@map("facilities")
}

model RestaurantCategory {
  id             String           @id @default(uuid())
  code           String           @unique
  label          String
  icon           String?
  restaurants    Restaurant[]
  reviewCriteria ReviewCriteria[]

  @@map("restaurant_categories")
}

model Cuisine {
  id                 String              @id @default(uuid())
  code               String              @unique
  label              String
  dishes             Dish[]
  restaurantCuisines RestaurantCuisine[]

  @@map("cuisines")
}

model RestaurantCuisine {
  restaurantId String     @map("restaurant_id")
  cuisineId    String     @map("cuisine_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  cuisine      Cuisine    @relation(fields: [cuisineId], references: [id], onDelete: Cascade)

  @@id([restaurantId, cuisineId])
  @@map("restaurant_cuisines")
}

model Dish {
  id            String     @id @default(uuid())
  name          String
  cuisineId     String?    @map("cuisine_id")
  cuisine       Cuisine?   @relation(fields: [cuisineId], references: [id])
  aliasKeywords String[]   @map("alias_keywords")
  menuItems     MenuItem[]

  // Dish is a curated/admin-managed catalog (not user-creatable, per
  // docs/06-database-erd.md) — a unique name enables find-or-create
  // (upsert) seeding/linking instead of accumulating accidental duplicates.
  @@unique([name])
  @@map("dishes")
}

model PriceRange {
  id          String       @id @default(uuid())
  code        String       @unique
  minVnd      Int          @map("min_vnd")
  maxVnd      Int?         @map("max_vnd")
  restaurants Restaurant[]

  @@map("price_ranges")
}

model Address {
  id              String      @id @default(uuid())
  line            String
  ward            String?
  district        String
  province        String
  fullAddressText String      @map("full_address_text")
  restaurant      Restaurant?

  @@map("addresses")
}

model Location {
  id       String                                 @id @default(uuid())
  lat      Decimal                                @db.Decimal(9, 6)
  lng      Decimal                                @db.Decimal(9, 6)
  // Kept in sync with lat/lng via a DB trigger — see migration.sql.
  geoPoint Unsupported("geography(Point, 4326)")? @map("geo_point")

  restaurant Restaurant?

  @@map("locations")
}

model Restaurant {
  id                String             @id @default(uuid())
  name              String
  slug              String             @unique
  description       String?
  categoryId        String             @map("category_id")
  category          RestaurantCategory @relation(fields: [categoryId], references: [id])
  priceRangeId      String?            @map("price_range_id")
  priceRange        PriceRange?        @relation(fields: [priceRangeId], references: [id])
  phone             String?
  // Admin-entered/verified only for now (no self-service owner-claim flow
  // exists yet — Restaurant.ownerId above is an unused stub). `verified`
  // only applies to facebook/instagram (the two platforms an admin can
  // actually confirm ownership of); tiktok/website have no such concept in
  // the UI, so there's no verified column for them.
  facebookUrl       String?            @map("facebook_url")
  facebookVerified  Boolean            @default(false) @map("facebook_verified")
  instagramUrl      String?            @map("instagram_url")
  instagramVerified Boolean            @default(false) @map("instagram_verified")
  tiktokUrl         String?            @map("tiktok_url")
  websiteUrl        String?            @map("website_url")
  addressId         String             @unique @map("address_id")
  address           Address            @relation(fields: [addressId], references: [id])
  locationId        String             @unique @map("location_id")
  location          Location           @relation(fields: [locationId], references: [id])
  submittedBy       String?            @map("submitted_by")
  submitter         User?              @relation("SubmittedRestaurants", fields: [submittedBy], references: [id])
  ownerId           String?            @map("owner_id")
  owner             User?              @relation("OwnedRestaurants", fields: [ownerId], references: [id])
  // User/admin-chosen "ảnh đại diện" — when set (and the photo is still
  // approved/not deleted), this is `thumbnailUrl` instead of the oldest
  // approved photo (the previous, purely-emergent default). Nullable: a
  // restaurant with no explicit choice, or whose chosen photo got removed,
  // just falls back to that same old behavior — see
  // RestaurantService/SearchService's thumbnail-resolution comment.
  coverPhotoId      String?            @unique @map("cover_photo_id")
  coverPhoto        Photo?             @relation("RestaurantCoverPhoto", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  deletedAt         DateTime?          @map("deleted_at")

  // Generated STORED column (name + description, unaccented) + GIN index —
  // see migration.sql; Prisma has no schema-level syntax for GENERATED ALWAYS
  // AS columns, same reason Location.geoPoint is Unsupported (§ near top of
  // this file). Dish-name/alias-based matching (per
  // docs/build-prompts/04-search-filter.md) is NOT folded into this column —
  // Postgres generated columns can only reference the same row, not joined
  // tables — so SearchService joins menu_items/dishes at query time instead.
  searchVector Unsupported("tsvector")? @map("search_vector")

  status              RestaurantStatus?
  cuisines            RestaurantCuisine[]
  openingHours        OpeningHour[]
  facilities          RestaurantFacility[]
  menus               Menu[]
  reviews             Review[]
  favorites           Favorite[]
  contributions       Contribution[]
  aiSummary           AISummary?
  crowdedStatuses     CrowdedStatus[]
  seatAvailabilities  SeatAvailability[]
  powerOutletStatuses PowerOutletStatus[]
  parkingInformation  ParkingInformation?

  @@index([categoryId])
  @@index([priceRangeId])
  @@map("restaurants")
}

model RestaurantStatus {
  restaurantId      String                      @id @map("restaurant_id")
  restaurant        Restaurant                  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  publicationStatus RestaurantPublicationStatus @default(pending) @map("publication_status")
  compositeScore    Decimal?                    @map("composite_score") @db.Decimal(3, 2)
  reviewCount       Int                         @default(0) @map("review_count")
  lastReviewAt      DateTime?                   @map("last_review_at")
  lastComputedAt    DateTime?                   @map("last_computed_at")
  // Raw page-view counter — every detail-page load counts, including repeat
  // views by the same visitor (no dedup), same convention as public video/
  // map platforms' "lượt xem". Incremented via an atomic `increment` update
  // from RestaurantService.getDetail/getDetailBySlug, never read-then-write.
  viewCount         Int                         @default(0) @map("view_count")

  @@map("restaurant_status")
}

model OpeningHour {
  id           String     @id @default(uuid())
  restaurantId String     @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dayOfWeek    Int        @map("day_of_week")
  openTime     DateTime?  @map("open_time") @db.Time
  closeTime    DateTime?  @map("close_time") @db.Time
  isClosed     Boolean    @default(false) @map("is_closed")
  // Open all 24 hours of this day — when true, openTime/closeTime/openTime2/
  // closeTime2 are all irrelevant (and normalized to null on write). Kept as
  // its own flag rather than a 00:00–23:59 sentinel, since that range would
  // otherwise need special-casing everywhere it's compared.
  isOpen24h    Boolean    @default(false) @map("is_open_24h")
  // Second time range for the same day (e.g. 11:00–14:00 lunch, then this
  // pair for 17:00–22:00 dinner) — exactly one extra range, not an
  // arbitrary list, matching the one real pattern this needs to support.
  // Still one row per (restaurantId, dayOfWeek); no unique-constraint change.
  openTime2    DateTime?  @map("open_time_2") @db.Time
  closeTime2   DateTime?  @map("close_time_2") @db.Time

  @@unique([restaurantId, dayOfWeek])
  @@map("opening_hours")
}

model RestaurantFacility {
  id           String     @id @default(uuid())
  restaurantId String     @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  facilityCode String     @map("facility_code")
  facility     Facility   @relation(fields: [facilityCode], references: [code])
  notes        String?

  @@unique([restaurantId, facilityCode])
  @@map("restaurant_facilities")
}

model Menu {
  id           String     @id @default(uuid())
  restaurantId String     @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String?
  isActive     Boolean    @default(true) @map("is_active")
  items        MenuItem[]

  @@map("menus")
}

model MenuItem {
  id        String  @id @default(uuid())
  menuId    String  @map("menu_id")
  menu      Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  dishId    String? @map("dish_id")
  dish      Dish?   @relation(fields: [dishId], references: [id])
  name      String
  priceVnd  Int     @map("price_vnd")
  // FK to Photo added once MediaModule exists (build-prompts/07).
  photoId   String? @map("photo_id")
  isPopular Boolean @default(false) @map("is_popular")
  category  String?

  @@map("menu_items")
}

// ---------- Search Intelligence (docs/06-database-erd.md §8) ----------

// Write-only in MVP (build-prompts/04-search-filter.md) — feeds V2
// personalization per docs/08-roadmap-sprint.md; no read API yet.
model SearchHistory {
  id             String   @id @default(uuid())
  userId         String?  @map("user_id")
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  deviceId       String?  @map("device_id")
  queryText      String?  @map("query_text")
  appliedFilters Json?    @map("applied_filters")
  resultCount    Int?     @map("result_count")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("search_history")
}

// ---------- Media (docs/06-database-erd.md §4, minimal stopgap) ----------

enum PhotoOwnerType {
  restaurant
  menu_item
  user_profile
  review
  contribution
  // Up to 3 photos of a restaurant's physical menu, attached to a Menu row
  // (ownerId = Menu.id) — see the "menu photos" feature, admin-web only.
  menu
}

// Two producers write this table now: the admin-only stopgap (PhotoService,
// build-prompts/05) which stores a plain admin-supplied URL directly as
// `storageKey`, and — as of build-prompts/07's MediaModule — a real
// signed-upload pipeline (MediaService) that re-encodes every image
// server-side before writing the row. `mimeType`/`fileSizeBytes` are only
// ever populated by the real pipeline (nullable, since the admin stopgap
// never had this info and there's no reason to migrate it retroactively).
// Ownership is polymorphic (ownerType/ownerId) per the ERD — Postgres/Prisma
// can't express a real FK across owner types, so this is validated at the
// application layer, not the DB.
//
// `ownerId` is nullable — a deliberate deviation from the ERD (which marks
// it required): the real upload flow confirms+stores a photo BEFORE its
// parent review/restaurant exists (the mobile client has no id yet to
// attach to), so photos start "unattached" (`ownerId: null`) and are
// re-parented by the owning create-endpoint via a `photoIds` field once the
// parent is created (see MediaService.reparent). Unattached photos older
// than 24h are swept by a background job (MediaService.sweepOrphans).
enum PhotoStatus {
  pending
  approved
  rejected
}

model Photo {
  id                 String            @id @default(uuid())
  ownerType          PhotoOwnerType    @map("owner_type")
  ownerId            String?           @map("owner_id")
  storageKey         String            @map("storage_key")
  thumbnailKey       String?           @map("thumbnail_key")
  uploadedBy         String?           @map("uploaded_by")
  uploader           User?             @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  width              Int?
  height             Int?
  mimeType           String?           @map("mime_type")
  fileSizeBytes      Int?              @map("file_size_bytes")
  // Gates PUBLIC visibility (see restaurant/review photo queries, which
  // filter `status: approved`) — admin-attached photos (admin/photo.service.ts)
  // set this to `approved` directly at creation (admin-curated, never run
  // through user moderation); user-uploaded photos (MediaService.confirm)
  // default to `pending` and get moderated synchronously before the caller
  // ever sees the response, same pattern as Review.status.
  status             PhotoStatus       @default(pending)
  moderationResultId String?           @map("moderation_result_id")
  moderationResult   ModerationResult? @relation(fields: [moderationResultId], references: [id])
  createdAt          DateTime          @default(now()) @map("created_at")
  deletedAt          DateTime?         @map("deleted_at")
  // Reverse side of Restaurant.coverPhoto — a bare pointer-back, never
  // queried from this side (no fields/references here, the FK lives on
  // Restaurant).
  coverOfRestaurant  Restaurant?       @relation("RestaurantCoverPhoto")

  @@index([ownerType, ownerId])
  @@map("photos")
}

// ---------- Reviews & Ratings (docs/06-database-erd.md §5) ----------

model ReviewCriteria {
  id                  String              @id @default(uuid())
  code                String              @unique
  label               String
  appliesToCategoryId String?             @map("applies_to_category_id")
  appliesToCategory   RestaurantCategory? @relation(fields: [appliesToCategoryId], references: [id])
  ratings             ReviewRating[]

  @@map("review_criteria")
}

enum ReviewStatus {
  pending
  published
  rejected
  hidden
}

model Review {
  id              String       @id @default(uuid())
  userId          String       @map("user_id")
  user            User         @relation(fields: [userId], references: [id])
  restaurantId    String       @map("restaurant_id")
  restaurant      Restaurant   @relation(fields: [restaurantId], references: [id])
  overallRating   Int          @map("overall_rating")
  comment         String?
  dishesOrdered   String[]     @map("dishes_ordered")
  billTotalVnd    Int?         @map("bill_total_vnd")
  partySize       Int?         @map("party_size")
  visitedAt       DateTime?    @map("visited_at")
  waitTimeMinutes Int?         @map("wait_time_minutes")
  wouldReturn     Boolean?     @map("would_return")
  status          ReviewStatus @default(pending)
  // Non-null triggers the public "Đã chỉnh sửa" marker — only set when an
  // edit happens >48h after createdAt, per docs/01-prd-mvp.md §10.5.
  editedAt        DateTime?    @map("edited_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  ratings ReviewRating[]
  helpfulVotes ReviewHelpfulVote[]
  replies      ReviewReply[]

  // "One active review per user per restaurant" (docs/06-database-erd.md §5)
  // needs a PARTIAL unique index (`WHERE deleted_at IS NULL`), which Prisma's
  // schema DSL can't express — hand-added in migration.sql, same pattern as
  // the geo/trigram indexes noted at the top of this file. Do not add a
  // plain `@@unique([userId, restaurantId])` here; it would wrongly block a
  // new review after a prior one was soft-deleted.
  @@index([restaurantId, status])
  @@map("reviews")
}

// A real, per-user toggle backing the profile page's "Lượt hữu ích" stat and
// each review's helpful count — replaces the old presentational-only
// "Hữu ích" button that had no backend behind it (see ReviewCard.tsx's prior
// doc comment).
model ReviewHelpfulVote {
  id        String   @id @default(uuid())
  reviewId  String   @map("review_id")
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([reviewId, userId])
  @@map("review_helpful_votes")
}

// Flat (non-nested) replies on a review — any authenticated user may reply,
// same moderation-free trust level as a review's own comment text.
model ReviewReply {
  id        String    @id @default(uuid())
  reviewId  String    @map("review_id")
  review    Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([reviewId])
  @@map("review_replies")
}

model ReviewRating {
  id         String         @id @default(uuid())
  reviewId   String         @map("review_id")
  review     Review         @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criteriaId String         @map("criteria_id")
  criteria   ReviewCriteria @relation(fields: [criteriaId], references: [id])
  score      Int

  @@unique([reviewId, criteriaId])
  @@map("review_ratings")
}

// ---------- Moderation & Trust (docs/06-database-erd.md §7) ----------

enum ModerationTargetType {
  review
  contribution
  photo
  video
  // Reports against an already-published restaurant have nowhere else to
  // route (ReportTargetType includes 'restaurant' but this enum originally
  // didn't) — added as a gap-fix so ReportService can create a queue-visible
  // ModerationResult for restaurant reports the same way it does for reviews.
  restaurant
}

enum ModerationRecommendedAction {
  auto_approve
  hold_for_review
  reject
}

enum ModerationDecision {
  pending
  approved
  rejected
  edit_requested
}

// Module 6 populates this with a rule-based stand-in check (wordlist +
// heuristics) instead of a real AIGateway call — see ReviewModerationService
// for the `// TODO Module 7` marker. The table/state-machine shape is the
// real one Module 7 will use unchanged, only the scoring implementation
// swaps out.
model ModerationResult {
  id                String                      @id @default(uuid())
  targetType        ModerationTargetType        @map("target_type")
  targetId          String                      @map("target_id")
  riskScore         Decimal                     @map("risk_score") @db.Decimal(3, 2)
  labels            String[]
  aiReason          String                      @map("ai_reason")
  recommendedAction ModerationRecommendedAction @map("recommended_action")
  decidedBy         String?                     @map("decided_by")
  decider           User?                       @relation("ModerationDecidedBy", fields: [decidedBy], references: [id])
  decision          ModerationDecision          @default(pending)
  decidedAt         DateTime?                   @map("decided_at")
  modelVersion      String                      @map("model_version")
  createdAt         DateTime                    @default(now()) @map("created_at")

  contribution Contribution?
  photos       Photo[]

  @@index([targetType, targetId])
  @@index([decision])
  @@map("moderation_results")
}

// ---------- Contribution (docs/06-database-erd.md §6, build-prompts/07) ----------
//
// Module 7 adds the community submission flow. Moderation reuses the exact
// rule-based-stand-in pattern already established for reviews (Module 6) —
// see ContributionModerationService — rather than a real AIGateway call
// (the Claude adapter is out of scope for this pass; see ai-gateway.interface.ts).

enum ContributionType {
  new_restaurant
  edit_suggestion
  status_update
  closure_report
}

enum ContributionStatus {
  pending
  auto_approved
  in_review
  approved
  rejected
  edit_requested
}

// Generic envelope for any user-submitted change — the single audit trail
// for "who changed what," independent of whether it was auto- or
// manually-approved (per the ERD). `targetRestaurantId` is null only for a
// brand-new restaurant submission (the restaurant is created *together with*
// this row, in the same transaction — see ContributionService.createNewRestaurant).
model Contribution {
  id                 String             @id @default(uuid())
  userId             String             @map("user_id")
  user               User               @relation(fields: [userId], references: [id])
  type               ContributionType
  targetRestaurantId String?            @map("target_restaurant_id")
  targetRestaurant   Restaurant?        @relation(fields: [targetRestaurantId], references: [id])
  payload            Json
  status             ContributionStatus @default(pending)
  moderationResultId String?            @unique @map("moderation_result_id")
  moderationResult   ModerationResult?  @relation(fields: [moderationResultId], references: [id])
  editSuggestion     EditSuggestion?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([targetRestaurantId])
  @@map("contributions")
}

// 1:1 detail for Contribution.type = edit_suggestion. `fieldName` is
// restricted at the application layer (DTO allow-list) to a fixed set of
// editable fields — not a fully generic path-based patcher — see
// ContributionService's edit-suggestion handler.
model EditSuggestion {
  id             String       @id @default(uuid())
  contributionId String       @unique @map("contribution_id")
  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  fieldName      String       @map("field_name")
  oldValue       Json?        @map("old_value")
  newValue       Json         @map("new_value")

  @@map("edit_suggestions")
}

enum ReportTargetType {
  restaurant
  review
}

enum ReportReason {
  spam
  inappropriate
  incorrect_info
  duplicate
  closed_down
  other
}

enum ReportStatus {
  open
  escalated
  resolved
  dismissed
}

// Business rule (ERD §7): 3+ independent closed_down reports on the same
// restaurant within a rolling 14-day window auto-escalates the linked
// Contribution's ModerationResult to high-priority — it never auto-hides
// the restaurant, only surfaces it prominently in the moderation queue.
// See ContributionService.checkClosureEscalation.
model Report {
  id          String           @id @default(uuid())
  reporterId  String           @map("reporter_id")
  reporter    User             @relation("ReportedBy", fields: [reporterId], references: [id])
  targetType  ReportTargetType @map("target_type")
  targetId    String           @map("target_id")
  reason      ReportReason
  description String?
  status      ReportStatus     @default(open)
  resolvedBy  String?          @map("resolved_by")
  resolver    User?            @relation("ReportResolvedBy", fields: [resolvedBy], references: [id])
  createdAt   DateTime         @default(now()) @map("created_at")
  resolvedAt  DateTime?        @map("resolved_at")

  @@unique([reporterId, targetType, targetId])
  @@map("reports")
}

// ---------- AI Summary (docs/06-database-erd.md §8, build-prompts/07) ----------
//
// Read-side only this pass — no real Claude `summarize()` call exists yet
// (see ai-summary-trigger.stub.ts). Rows only ever appear via
// prisma/seed-ai-summaries.ts until a future module wires up generation.

model AISummary {
  id                String     @id @default(uuid())
  restaurantId      String     @unique @map("restaurant_id")
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  summaryText       String     @map("summary_text")
  pros              String[]
  cons              String[]
  sourceReviewCount Int        @map("source_review_count")
  modelVersion      String     @map("model_version")
  generatedAt       DateTime   @map("generated_at")

  @@map("ai_summaries")
}

// ---------- Situational / Live-ish Status (docs/06-database-erd.md §9) ----------
//
// Community-reported, ephemeral signals — CrowdedStatus/SeatAvailability/
// PowerOutletStatus are insert-only logs (the "current" value is computed by
// the reading service from recent rows, not stored); ParkingInformation is
// the one 1:1, more-static exception. All are created via
// ContributionModule's status-report endpoint and auto-apply on a clean
// moderation pass (see build-prompts/07-contribution-media-moderation-ai.md).

enum CrowdedLevel {
  empty
  light
  moderate
  crowded
  full
}

model CrowdedStatus {
  id           String       @id @default(uuid())
  restaurantId String       @map("restaurant_id")
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  level        CrowdedLevel
  reportedBy   String       @map("reported_by")
  reporter     User         @relation("CrowdedStatusReportedBy", fields: [reportedBy], references: [id])
  reportedAt   DateTime     @default(now()) @map("reported_at")

  @@index([restaurantId, reportedAt])
  @@map("crowded_statuses")
}

enum SeatAvailabilityLevel {
  plenty
  limited
  full
}

model SeatAvailability {
  id           String                @id @default(uuid())
  restaurantId String                @map("restaurant_id")
  restaurant   Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  level        SeatAvailabilityLevel
  reportedBy   String                @map("reported_by")
  reporter     User                  @relation("SeatAvailabilityReportedBy", fields: [reportedBy], references: [id])
  reportedAt   DateTime              @default(now()) @map("reported_at")

  @@index([restaurantId, reportedAt])
  @@map("seat_availabilities")
}

enum PowerOutletLevel {
  plenty
  some
  none
}

// Primarily relevant to quan_ca_phe per the ERD, but not schema-restricted
// to that category — the same lax pattern as ReviewCriteria.appliesToCategory.
model PowerOutletStatus {
  id           String           @id @default(uuid())
  restaurantId String           @map("restaurant_id")
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  level        PowerOutletLevel
  reportedBy   String           @map("reported_by")
  reporter     User             @relation("PowerOutletReportedBy", fields: [reportedBy], references: [id])
  reportedAt   DateTime         @default(now()) @map("reported_at")

  @@index([restaurantId, reportedAt])
  @@map("power_outlet_statuses")
}

// 1:1 (restaurantId is both PK and FK) — more static than the three logs
// above, upserted in place rather than appended.
model ParkingInformation {
  restaurantId        String     @id @map("restaurant_id")
  restaurant          Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  hasCarParking       Boolean    @map("has_car_parking")
  hasMotorbikeParking Boolean    @map("has_motorbike_parking")
  isFree              Boolean?   @map("is_free")
  notes               String?
  lastUpdatedBy       String?    @map("last_updated_by")
  updater             User?      @relation("ParkingLastUpdatedBy", fields: [lastUpdatedBy], references: [id])
  lastUpdatedAt       DateTime?  @map("last_updated_at")

  @@map("parking_information")
}

// ---------- Favorites & Notifications (docs/06-database-erd.md §6, §8) ----------

model Favorite {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String     @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([userId, restaurantId])
  @@map("favorites")
}

enum NotificationType {
  moderation_result
  report_resolved
  contribution_status
  // Admin/moderator-facing (unlike the other three, which target the
  // contributor) — fired when a new contribution or review lands in the
  // Admin Moderation Queue as `pending`. See NotificationService.notifyAdmins.
  moderation_queue_new
  // Fired at ReviewService.toggleHelpful — someone (not the author) marks
  // the author's review helpful.
  review_helpful_vote
  // Fired once, the moment a single review's helpful count first reaches
  // REVIEW_HELPFUL_MILESTONE (see review.service.ts) — guarded so it can't
  // re-fire on every subsequent toggle past the threshold.
  review_helpful_milestone
  // Fired at AdminRestaurantService.replaceOpeningHours for every user who
  // has this restaurant favorited, when the new hours differ from the old.
  restaurant_hours_changed
}

// `payload` carries the deep-link target (screen + id) per the ERD note —
// e.g. `{ screen: 'Reviews', restaurantId }` for a moderation_result
// notification about a review. No producer exists until
// docs/build-prompts/07-contribution-media-moderation-ai.md's moderation
// queue writes real rows on decisions; a few demo rows are seeded directly
// (prisma/seed-notifications.ts) so this module's UI has something real to
// render/test in the meantime.
model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  payload   Json
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}

enum PushPlatform {
  ios
  android
}

// One row per registered device, not a single column on User — a user can
// be signed in on more than one device, and each needs its own Expo push
// token that outlives/independent of the others (e.g. one device logs out
// without affecting push delivery to the rest).
model PushToken {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String       @unique
  platform  PushPlatform
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_tokens")
}

// ---------- System (docs/06-database-erd.md §10) ----------

// Append-only audit trail for every admin/moderator mutation, per
// docs/05-system-architecture.md §10 — required starting this module.
model AuditLog {
  id          String   @id @default(uuid())
  actorId     String   @map("actor_id")
  actor       User     @relation(fields: [actorId], references: [id])
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@map("audit_log")
}
