# Copy to `.env` at the REPO ROOT (next to docker-compose.yml) — this is a
# different file from backend/.env! Docker Compose reads a root-level .env
# to resolve the ${VAR} substitutions inside docker-compose.prod.yml
# (POSTGRES_PASSWORD, MINIO_ROOT_USER, MINIO_ROOT_PASSWORD) — it does NOT
# read backend/.env for that (that one is loaded into the backend
# container's own runtime environment via `env_file:`, a separate
# mechanism). See docs/deploy-oracle-cloud.md for the full explanation and
# the exact deploy commands.
#
# Generate real random values before deploying — do not keep the dev
# defaults once MinIO's port is open to the public internet (see
# docker-compose.prod.yml's comment on why MinIO's S3 API port must stay
# public). A quick way to generate a strong value: `openssl rand -hex 24`.

POSTGRES_PASSWORD=change-me-generate-a-real-value

MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-generate-a-real-value
